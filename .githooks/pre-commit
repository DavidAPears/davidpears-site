#!/bin/sh
# Runs before every commit. Order matters: secrets first, because a leaked key
# is the only failure here that cannot be undone by a follow-up commit.
#
# Enable in a fresh clone with:  git config core.hooksPath .githooks
# Skip in an emergency with:     git commit --no-verify

set -e

staged() {
  git diff --cached --name-only --diff-filter=ACM
}

# --- 1. secrets -------------------------------------------------------------

fail=0

env_staged=$(staged | grep -E '(^|/)\.env' | grep -v '\.env\.example$' || true)
if [ -n "$env_staged" ]; then
  echo "BLOCKED: env file staged for commit:"
  echo "$env_staged" | sed 's/^/  /'
  echo "  Secrets belong in .env.local (ignored) and in the host's env settings."
  fail=1
fi

leak=$(git diff --cached --diff-filter=ACM -U0 \
  | grep -E '^\+' \
  | grep -vE '^\+\+\+' \
  | grep -iEn "(api[_-]?key|secret|token|password)[\"']?[[:space:]]*[:=][[:space:]]*[\"']?[A-Za-z0-9_-]{20,}" || true)
if [ -n "$leak" ]; then
  echo "BLOCKED: this looks like a credential in source:"
  echo "$leak" | cut -c1-120 | sed 's/^/  /'
  echo "  Read it from process.env instead."
  fail=1
fi

if [ "$fail" -ne 0 ]; then
  echo
  echo "Nothing was committed."
  exit 1
fi

# --- 2. format --------------------------------------------------------------

fmt=$(staged | grep -E '\.(ts|tsx|js|mjs|css|json|md)$' || true)
if [ -n "$fmt" ]; then
  echo "→ prettier"
  echo "$fmt" | xargs npx prettier --write --ignore-unknown --log-level warn
  # Re-stage anything prettier tidied, so the commit matches what is on disk.
  echo "$fmt" | xargs git add
fi

# --- 3. lint ----------------------------------------------------------------

echo "→ eslint"
npx eslint . --max-warnings 0

# --- 4. types ---------------------------------------------------------------

echo "→ tsc"
npx tsc --noEmit

echo "✓ ready to commit"
